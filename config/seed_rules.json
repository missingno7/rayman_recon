{
 "note": "PS1-decomp -> DOS source rewrites used by tools/seed.py. Each rule is semantics-preserving and evidence-backed: 'evidence' cites how often the same edit occurs between PS1 bodies and accepted STRICT DOS bodies (python tools/seed.py mine, 173 functions) or the DOS layout facts. Rules apply in order. Flag rules map PS1's u32 flag word to the DOS obj_t bitfields/fields (src/include/obj.h).",
 "rules": [
  {
   "pattern": "\\bObj\\b",
   "repl": "obj_t",
   "evidence": "mine: Obj->obj_t x136"
  },
  {
   "pattern": "\\bObjState\\b",
   "repl": "eta_t",
   "evidence": "DOS obj.h eta_t = PS1 ObjState (8 bytes)"
  },
  {
   "pattern": "\\bAnimation\\b",
   "repl": "anim_t",
   "evidence": "DOS obj.h anim_t"
  },
  {
   "pattern": "\\bSprite\\b",
   "repl": "sprite_t",
   "evidence": "DOS obj.h sprite_t"
  },
  {
   "pattern": "(->|\\.)x_pos\\b",
   "repl": "\\1x",
   "evidence": "mine: x_pos->x x62"
  },
  {
   "pattern": "(->|\\.)y_pos\\b",
   "repl": "\\1y",
   "evidence": "mine: y_pos->y x67"
  },
  {
   "pattern": "(->|\\.)init_x_pos\\b",
   "repl": "\\1init_x",
   "evidence": "mine x12"
  },
  {
   "pattern": "(->|\\.)init_y_pos\\b",
   "repl": "\\1init_y",
   "evidence": "mine x10"
  },
  {
   "pattern": "(->|\\.)screen_x_pos\\b",
   "repl": "\\1screen_x",
   "evidence": "DOS obj.h screen_x (+0x36)"
  },
  {
   "pattern": "(->|\\.)screen_y_pos\\b",
   "repl": "\\1screen_y",
   "evidence": "DOS obj.h screen_y (+0x38)"
  },
  {
   "pattern": "(->|\\.)field20_0x36\\b",
   "repl": "\\1follow_id",
   "evidence": "mine x10"
  },
  {
   "pattern": "(->|\\.)field23_0x3c\\b",
   "repl": "\\1param",
   "evidence": "mine x24"
  },
  {
   "pattern": "(->|\\.)field24_0x3e\\b",
   "repl": "\\1link",
   "evidence": "mine x31"
  },
  {
   "pattern": "(->|\\.)field12_0x26\\b",
   "repl": "\\1sub_speed",
   "evidence": "PS1 0x26 after screen_y = DOS sub_speed (+0x3a)"
  },
  {
   "pattern": "(->|\\.)cmd_context_index\\b",
   "repl": "\\1cmd_context_depth",
   "evidence": "DOS obj.h (+0x7c)"
  },
  {
   "pattern": "(->|\\.)field56_0x69\\b",
   "repl": "\\1config",
   "evidence": "PS1 0x69 between cmd_context_index and display_prio = DOS config (+0x7d)"
  },
  {
   "pattern": "([\\w\\]\\)]+(?:->|\\.)\\w*?)flags\\s*\\|=\\s*FLG\\(OBJ_ACTIVE\\)",
   "repl": "\\1is_active = 1",
   "evidence": "mine: FLG(OBJ_ACTIVE) -> is_active x33 (DOS has a separate s32 is_active)"
  },
  {
   "pattern": "([\\w\\]\\)]+(?:->|\\.)\\w*?)flags\\s*&=\\s*~FLG\\(OBJ_ACTIVE\\)",
   "repl": "\\1is_active = 0",
   "evidence": "same"
  },
  {
   "pattern": "([\\w\\]\\)]+(?:->|\\.)\\w*?)flags\\s*&\\s*FLG\\(OBJ_ACTIVE\\)",
   "repl": "\\1is_active",
   "evidence": "same"
  },
  {
   "pattern": "([\\w\\]\\)]+(?:->|\\.)\\w*?)flags\\s*\\|=\\s*FLG\\(OBJ_(FLIP_X|ALIVE|CMD_TEST|READ_CMDS|FOLLOW_ENABLED)\\)",
   "repl": "\\1flags.@\\2 = 1",
   "evidence": "mine: |= FLG(OBJ_FLIP_X)/ALIVE -> .flip_x/.alive = 1 x25"
  },
  {
   "pattern": "([\\w\\]\\)]+(?:->|\\.)\\w*?)flags\\s*&=\\s*~FLG\\(OBJ_(FLIP_X|ALIVE|CMD_TEST|READ_CMDS|FOLLOW_ENABLED)\\)",
   "repl": "\\1flags.@\\2 = 0",
   "evidence": "mine: &= ~FLG(...) -> = 0 x41"
  },
  {
   "pattern": "([\\w\\]\\)]+(?:->|\\.)\\w*?)flags\\s*\\^=\\s*FLG\\(OBJ_(FLIP_X|ALIVE|CMD_TEST|READ_CMDS|FOLLOW_ENABLED)\\)",
   "repl": "\\1flags.@\\2 ^= 1",
   "evidence": "bitfield toggle, same flag map"
  },
  {
   "pattern": "([\\w\\]\\)]+(?:->|\\.)\\w*?)flags\\s*&\\s*FLG\\(OBJ_(FLIP_X|ALIVE|CMD_TEST|READ_CMDS|FOLLOW_ENABLED)\\)",
   "repl": "\\1flags.@\\2",
   "evidence": "mine: & FLG(OBJ_FLIP_X) -> .flip_x x16+"
  },
  {
   "pattern": "@FLIP_X",
   "repl": "flip_x",
   "evidence": "flag name map"
  },
  {
   "pattern": "@ALIVE",
   "repl": "alive",
   "evidence": "flag name map"
  },
  {
   "pattern": "@CMD_TEST",
   "repl": "command_test",
   "evidence": "flag name map"
  },
  {
   "pattern": "@READ_CMDS",
   "repl": "read_commands",
   "evidence": "flag name map"
  },
  {
   "pattern": "@FOLLOW_ENABLED",
   "repl": "follow_enabled",
   "evidence": "flag name map"
  },
  {
   "pattern": "\\btrue\\b",
   "repl": "1",
   "evidence": "mine x20"
  },
  {
   "pattern": "\\bfalse\\b",
   "repl": "0",
   "evidence": "mine x31"
  },
  {
   "pattern": "\\bcalc_obj_pos_map\\b",
   "repl": "calc_obj_pos",
   "evidence": "mine x19 (PS1 rename)"
  },
  {
   "pattern": "\\b__builtin_memcpy\\b",
   "repl": "memcpy",
   "evidence": "Watcom <string.h> intrinsic (COMPILER.md)"
  },
  {
   "pattern": "\\b__builtin_abs\\b",
   "repl": "abs",
   "evidence": "Watcom <stdlib.h> abs; DOS STRICT sources use abs()"
  },
  {
   "pattern": "/\\*\\s*[0-9A-F]+ 80[0-9A-F]{6} -O2[^*]*\\*/",
   "repl": "",
   "evidence": "PS1 address comment"
  }
 ],
 "prelude": "/* tools/seed.py compat prelude: PS1 helper macros as defined in rayman-ps1-decomp include/common.h;\n   each guarded separately so a unit's own (DOS-verified) definition wins */\n#include <string.h>\n#include <stdlib.h>\n#ifndef FLG\n#define FLG(x) (1 << x)\n#endif\n#ifndef LEN\n#define LEN(x) (sizeof(x) / sizeof(x[0]))\n#endif\n#ifndef MAX_1\n#define MAX_1(x, y) ((x) > (y) ? (x) : (y))\n#endif\n#ifndef MAX_2\n#define MAX_2(x, y) if (x < y) x = y;\n#endif\n#ifndef MAX_3\n#define MAX_3(x, y) if (y > x) x = y;\n#endif\n#ifndef MIN_1\n#define MIN_1(x, y) ((x) < (y) ? (x) : (y))\n#endif\n#ifndef MIN_2\n#define MIN_2(x, y) if (x > y) x = y;\n#endif\n#ifndef MIN_3\n#define MIN_3(x, y) if (y < x) x = y;\n#endif\n#ifndef ABS\n#define ABS(x) (x >= 0 ? (x) : -(x))\n#endif\n#ifndef SGN\n#define SGN(x) (x >= 0 ? (x > 0 ? 1 : 0) : -1)\n#endif\n#ifndef ashl16\n#define ashl16(v, b) ((v) << (b))\n#endif\n#ifndef ashr16\n#define ashr16(v, b) ((v) >> (b))\n#endif\n"
}

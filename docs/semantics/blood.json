   "c_type": "void DoEffectBloodOut(void)",
   "meaning": "Seed RNG, zero320 signed32 column offsets, choose10 seeds among160 two-pixel columns with speed2/3 rows per iteration. Propagate random nondecreasing heights left/right, finish when all observed offsets>=64000. On incomplete iterations sync then copy two-pixel source words downward by per-column byte offset, black above. DOS origin remains the frame start; exact comparison is offset<row*320+2*column, not simply offset<row*320.",
   "unit": "see parameters/result/side-effect contract",
   "value_domain": {
    "limitation": "Observed operations/initial values only; no declaration-capacity or universal runtime-range proof.",
    "computation": [
     "done = 0",
     "clear_offset = 0",
     "do ... while (clear_offset != 0x500)",
     "clear_offset += 4",
     "*((s32 *) ((((u8 *) PosYLine) + clear_offset) - 4)) = 0",
     "for (seed_offset = 0; seed_offset < 10; ++seed_offset)",
     "seed_offset = 0",
     "PosXLine[seed_offset] = myRand(159)",
     "SpeedYLine[seed_offset] = (myRand(1) + 2) * 320",
     "while (!done)",
     "done = 1",
     "for (line_offset = 0; line_offset < 10; ++line_offset)",
     "line_offset = 0",
     "PosYLine[PosXLine[line_offset]] += SpeedYLine[line_offset]",
     "if (PosYLine[PosXLine[line_offset]] < 64000)",
     "for (j = PosXLine[line_offset] - 1; (j >= 0) && (PosYLine[j + 1] >= PosYLine[j]); --j)",
     "j = PosXLine[line_offset] - 1",
     "PosYLine[j] = ((PosYLine[j] / 320) + myRand((PosYLine[j + 1] / 320) - (PosYLine[j] / 320))) * 320",
     "if (PosYLine[j] < 64000)",
     "for (j = PosXLine[line_offset] + 1; (j < 160) && (PosYLine[j - 1] >= PosYLine[j]); ++j)",
     "j = PosXLine[line_offset] + 1",
     "PosYLine[j] = (myRand((PosYLine[j - 1] / 320) - (PosYLine[j] / 320)) + (PosYLine[j] / 320)) * 320",
     "if (!done)",
     "dst = display_buffer",
     "src = DrawBufferNormal",
     "line = PosYLine",
     "row_start = dst",
     "for (row = 200; row != 0; --row)",
     "row = 200",
     "for (pixels = 320; pixels != 0; pixels -= 2)",
     "pixels = 320",
     "pixels -= 2",
     "if (((s32) ((*line) + row_start)) < ((s32) dst))",
     "*((s16 *) dst) = *((s16 *) (&src[-(*line)]))",
     "*((s16 *) dst) = 0",
     "dst += 2",
     "src += 2",
     "line -= 160"
    ]
   },
